+    std::pair<const unsigned char *, unsigned int> RetroFrame::GetResourceData(WORD id) const
+    {
+        static const std::map<WORD, const char *> externalFirmware = {
+            {IDR_DISK2_13SECTOR_FW, "DISK2-13sector.rom"},
+            {IDR_DISK2_16SECTOR_FW, "DISK2.rom"},
+            {IDR_SSC_FW, "SSC.rom"},
+            {IDR_HDDRVR_FW, "Hddrvr.bin"},
+            {IDR_HDDRVR_V2_FW, "Hddrvr-v2.bin"},
+            {IDR_HDC_SMARTPORT_FW, "HDC-SmartPort.bin"},
+            {IDR_PRINTDRVR_FW, "Parallel.rom"},
+            {IDR_MOCKINGBOARD_D_FW, "Mockingboard-D.rom"},
+            {IDR_MOUSEINTERFACE_FW, "MouseInterface.rom"},
+            {IDR_THUNDERCLOCKPLUS_FW, "ThunderClockPlus.rom"},
+            {IDR_TKCLOCK_FW, "TKClock.rom"},
+            {IDR_APPLE2_ROM, "Apple2.rom"},
+            {IDR_APPLE2_PLUS_ROM, "Apple2_Plus.rom"},
+            {IDR_APPLE2_JPLUS_ROM, "Apple2_JPlus.rom"},
+            {IDR_APPLE2E_ROM, "Apple2e.rom"},
+            {IDR_APPLE2E_ENHANCED_ROM, "Apple2e_Enhanced.rom"},
+            {IDR_PRAVETS_82_ROM, "PRAVETS82.ROM"},
+            {IDR_PRAVETS_8M_ROM, "PRAVETS8M.ROM"},
+            {IDR_PRAVETS_8C_ROM, "PRAVETS8C.ROM"},
+            {IDR_TK3000_2E_ROM, "TK3000e.rom"},
+            {IDR_BASE_64A_ROM, "Base64A.rom"},
+            {IDR_FREEZES_F8_ROM, "Freezes_Non-autostart_F8_Rom.rom"},
+            {IDR_APPLE2_VIDEO_ROM, "Apple2_Video.rom"},
+            {IDR_APPLE2_JPLUS_VIDEO_ROM, "Apple2_JPlus_Video.rom"},
+            {IDR_APPLE2E_ENHANCED_VIDEO_ROM, "Apple2e_Enhanced_Video.rom"},
+            {IDR_BASE64A_VIDEO_ROM, "Base64A_German_Video.rom"},
+        };
+        const auto filename = externalFirmware.find(id);
+        if (filename == externalFirmware.end())
+            return common2::GNUFrame::GetResourceData(id);
+        const auto cached = myExternalFirmware.find(id);
+        if (cached != myExternalFirmware.end())
+            return {cached->second.data(), static_cast<unsigned int>(cached->second.size())};
+        if (system_directory.empty())
+            throw std::runtime_error("AppleWin system directory is unavailable");
+        const std::filesystem::path path = std::filesystem::path(system_directory) / filename->second;
+        std::ifstream input(path, std::ios::binary | std::ios::ate);
+        if (!input)
+            throw std::runtime_error("Required external AppleWin firmware is unavailable: " +
+                                     std::string(filename->second));
+        const std::streamsize size = input.tellg();
+        if (size <= 0 || size > static_cast<std::streamsize>(UINT32_MAX))
+            throw std::runtime_error("Invalid external AppleWin firmware size: " +
+                                     std::string(filename->second));
+        input.seekg(0, std::ios::beg);
+        std::vector<unsigned char> bytes(static_cast<size_t>(size));
+        if (!input.read(reinterpret_cast<char *>(bytes.data()), size))
+            throw std::runtime_error("Cannot read external AppleWin firmware: " +
+                                     std::string(filename->second));
+        const auto inserted = myExternalFirmware.emplace(id, std::move(bytes));
+        return {inserted.first->second.data(),
+                static_cast<unsigned int>(inserted.first->second.size())};
+    }
 
