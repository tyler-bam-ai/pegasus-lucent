+enum STATE_PAUSE_RESULT
+{
+	STATE_PAUSE_FAILED = -1,
+	STATE_PAUSE_ALREADY_PAUSED = 0,
+	STATE_PAUSE_OWNED = 1,
+};
+
+static int pause_vm_for_state()
+{
+	if(!m_virtualMachine) return STATE_PAUSE_FAILED;
+	if(m_virtualMachine->GetStatus() != CVirtualMachine::RUNNING)
+		return m_virtualMachine->GetStatus() == CVirtualMachine::PAUSED ?
+		    STATE_PAUSE_ALREADY_PAUSED : STATE_PAUSE_FAILED;
+	auto token = m_virtualMachine->PauseAsyncForLibretroState();
+	auto gsHandler = static_cast<CGSH_OpenGL_Libretro*>(m_virtualMachine->GetGSHandler());
+	auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(1500);
+	while(std::chrono::steady_clock::now() < deadline)
+	{
+		if(token->load(std::memory_order_acquire) == 2 &&
+		   m_virtualMachine->GetStatus() == CVirtualMachine::PAUSED)
+			return STATE_PAUSE_OWNED;
+		// The libretro GS executes on this thread. Drain only pending work;
+		// ProcessSingleFrame blocks waiting for a future flip and Release()
+		// destroys the live GL renderer.
+		if(gsHandler) gsHandler->DrainPendingCallsForState();
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+	int expected = 0;
+	if(token->compare_exchange_strong(expected, 3, std::memory_order_acq_rel))
+		return STATE_PAUSE_FAILED;
+	expected = 1;
+	if(token->compare_exchange_strong(expected, 4, std::memory_order_acq_rel))
+		return STATE_PAUSE_FAILED;
+	if(token->load(std::memory_order_acquire) == 2 &&
+	   m_virtualMachine->GetStatus() == CVirtualMachine::PAUSED)
+		return STATE_PAUSE_OWNED;
+	return STATE_PAUSE_FAILED;
+}
+
+static void resume_vm_after_state(int pauseResult)
+{
+	if(pauseResult == STATE_PAUSE_OWNED && m_virtualMachine) m_virtualMachine->Resume();
+}
