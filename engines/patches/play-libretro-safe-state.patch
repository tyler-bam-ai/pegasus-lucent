+void CGSHandler::DrainPendingCallsForState()
+{
+	// State operations run on the non-threaded GS owner. Never call
+	// ProcessSingleFrame here: it waits for a future flip and deadlocks if
+	// the VM pause reaches its mailbox before queuing one. Only drain work
+	// that already exists, then consume any flip marker produced while the
+	// VM was being stopped.
+	while(m_mailBox.IsPending()) m_mailBox.ReceiveCall();
+	m_flipped = false;
+}
