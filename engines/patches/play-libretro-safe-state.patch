+CPS2VM::LibretroPauseToken CPS2VM::PauseAsyncForLibretroState()
+{
+	auto token = std::make_shared<std::atomic<int>>(0);
+	if(m_nStatus == PAUSED)
+	{
+		token->store(2, std::memory_order_release);
+		return token;
+	}
+	m_mailBox.SendCall([this, token]() {
+		int expected = 0;
+		if(!token->compare_exchange_strong(expected, 1, std::memory_order_acq_rel)) return;
+		if(token->load(std::memory_order_acquire) != 1) return;
+		PauseImpl();
+		OnMachineStateChange();
+		OnRunningStateChange();
+		expected = 1;
+		if(token->compare_exchange_strong(expected, 2, std::memory_order_acq_rel)) return;
+		// The bounded caller withdrew a request after this callback claimed it.
+		// Undo a pause that won the narrow cancellation race before returning.
+		ResumeImpl();
+		OnRunningStateChange();
+		token->store(3, std::memory_order_release);
+	});
+	return token;
+}
